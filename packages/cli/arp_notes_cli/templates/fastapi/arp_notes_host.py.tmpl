def build_host_config() -> HostConfig:
    """The one object everything takes. INTEGRATING.md shows the optional judge, hooks, hygiene."""
    return HostConfig(
        db=HostDb(),
        principal=HostPrincipal(),
        # Attachment bytes on local disk. Swap for PostgresStorage or S3Storage (INTEGRATING.md)
        # when the app runs on more than one machine or has no persistent disk.
        storage=DiskStorage(Path(os.environ.get("ARP_NOTES_BLOB_DIR", "data/arp-notes-blobs"))),
        signer=HostSigner(),
        schemes=[HostLinks()],
        policy=Policy(),  # attachments, MIME allowlist, size limits, kinds, export (ports.Policy)
        # judge=None,     # a Judge ranks ambiguous candidates (JevChoiceJudge, ChainJudge)
        # hooks=None,     # Hooks(on_event=..., on_action_item=...): activity log, backlog items
        # hygiene=None,   # Hygiene(detect=..., merge=...): duplicate entities in this app
    )


def mount_notes(
    app: FastAPI, prefix: str = DEFAULT_PREFIX, public_base_url: str | None = None
) -> HostConfig:
    """Mount the notes routes on `app` under `prefix` and return the config (for the MCP calls).

    Keep the default prefix: the CLI and the UI package call /api/v1/notes/... Set
    `public_base_url` (https://app.example.com) when the app sits behind a proxy, so signed
    attachment URLs name the public host.
    """
    cfg = build_host_config()
    private, public = build_routers(cfg, prefix, public_base_url)
    app.include_router(private, prefix=prefix)  # Bearer-authenticated through HostPrincipal
    app.include_router(public, prefix=prefix)  # signed attachment URLs, no Authorization header
    return cfg


def register_notes_mcp(mcp_server: Any, cfg: HostConfig | None = None) -> None:
    """Register the notes tools (13, plus 4 for hygiene) on a FastMCP server.

    TODO(arp-notes): call this where your app creates its FastMCP server. An app that keeps its
    own tool registry iterates `arp_notes.mcp.TOOLS` instead (INTEGRATING.md).
    """
    register_fastmcp(mcp_server, cfg or build_host_config())


def mount_notes_mcp_http(app: FastAPI, cfg: HostConfig, path: str = "/mcp") -> None:
    """A stand-in MCP endpoint (JSON-RPC on one POST route) so the conformance kit's MCP checks run.

    Delete it once the app serves the same tools through a real MCP server; point the kit at that
    with ARP_NOTES_MCP_URL.
    """
    tools = {spec.name: spec for spec in TOOLS}

    @app.post(path)
    async def mcp(request: Request) -> Response:
        user_id = cfg.principal.current_user_id(request)
        message = await request.json()
        if "id" not in message:  # a notification
            return Response(status_code=202)
        method, params = message["method"], message.get("params") or {}
        result: dict[str, Any]
        if method == "initialize":
            result = {
                "protocolVersion": params.get("protocolVersion", "2025-03-26"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "arp-notes-host", "version": "0"},
            }
        elif method == "tools/list":
            result = {
                "tools": [
                    {"name": t.name, "description": t.description, "inputSchema": t.input_schema}
                    for t in tools.values()
                ]
            }
        elif method == "tools/call":
            spec = tools[params["name"]]
            data = await run_in_threadpool(
                lambda: spec.handler(cfg, user_id, **(params.get("arguments") or {}))
            )
            result = {
                "content": [{"type": "text", "text": json.dumps(data)}],
                "structuredContent": data,
                "isError": False,
            }
        else:
            error = {"code": -32601, "message": f"no method {method}"}
            return JSONResponse({"jsonrpc": "2.0", "id": message["id"], "error": error})
        return JSONResponse({"jsonrpc": "2.0", "id": message["id"], "result": result})
