{
  "$defs": {
    "HygieneBlock": {
      "additionalProperties": true,
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/HygieneIssue"
          },
          "maxItems": 10,
          "title": "Issues",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "issues",
        "total",
        "truncated"
      ],
      "title": "HygieneBlock",
      "type": "object"
    },
    "HygieneFix": {
      "additionalProperties": true,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "dry_run_first": {
          "title": "Dry Run First",
          "type": "boolean"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "reversible": {
          "title": "Reversible",
          "type": "boolean"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tool",
        "arguments",
        "dry_run_first",
        "reversible"
      ],
      "title": "HygieneFix",
      "type": "object"
    },
    "HygieneIssue": {
      "additionalProperties": true,
      "properties": {
        "detected_by": {
          "enum": [
            "core",
            "host"
          ],
          "title": "Detected By",
          "type": "string"
        },
        "explanation": {
          "description": "Plain language for the client LLM to relay",
          "title": "Explanation",
          "type": "string"
        },
        "fixes": {
          "items": {
            "$ref": "#/$defs/HygieneFix"
          },
          "title": "Fixes",
          "type": "array"
        },
        "key": {
          "description": "Stable: '<kind>:<entity_type>:<sorted ids joined by ,>' or '<kind>:note:<id>'",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "duplicate_entities",
            "tombstoned_note",
            "pending_review",
            "orphaned_links",
            "unreferenced_blobs",
            "unresolved_mentions"
          ],
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warn",
            "action"
          ],
          "title": "Severity",
          "type": "string"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/HygieneSubject"
          },
          "title": "Subjects",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "severity",
        "title",
        "explanation",
        "subjects",
        "fixes",
        "detected_by"
      ],
      "title": "HygieneIssue",
      "type": "object"
    },
    "HygieneSubject": {
      "additionalProperties": true,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "entity_type",
        "entity_id",
        "label"
      ],
      "title": "HygieneSubject",
      "type": "object"
    },
    "NoteSummary": {
      "additionalProperties": true,
      "properties": {
        "action_count": {
          "title": "Action Count",
          "type": "integer"
        },
        "attachment_count": {
          "title": "Attachment Count",
          "type": "integer"
        },
        "deleted_at": {
          "anyOf": [
            {
              "description": "ISO-8601 timestamp, e.g. 2026-10-18T14:30:00",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deleted At"
        },
        "duration_min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Min"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "last_synced_at": {
          "anyOf": [
            {
              "description": "ISO-8601 timestamp, e.g. 2026-10-18T14:30:00",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Synced At"
        },
        "link_count": {
          "title": "Link Count",
          "type": "integer"
        },
        "note_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Date"
        },
        "origin": {
          "enum": [
            "app",
            "source"
          ],
          "title": "Origin",
          "type": "string"
        },
        "person": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Person"
        },
        "review_pending": {
          "title": "Review Pending",
          "type": "integer"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "source_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source System"
        },
        "source_workspace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Workspace"
        },
        "thumbnail_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Signed content_url of the first image attachment, valid 1 h",
          "title": "Thumbnail Url"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "top_links": {
          "description": "At most 4 confirmed links",
          "items": {
            "$ref": "#/$defs/TopLink"
          },
          "title": "Top Links",
          "type": "array"
        },
        "updated_at": {
          "description": "ISO-8601 timestamp, e.g. 2026-10-18T14:30:00",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "origin",
        "link_count",
        "attachment_count",
        "updated_at",
        "top_links",
        "action_count",
        "review_pending"
      ],
      "title": "NoteSummary",
      "type": "object"
    },
    "SyncSource": {
      "additionalProperties": true,
      "description": "K§2: one row of the 'Last sync' line in GET /notes.",
      "properties": {
        "last_synced_at": {
          "anyOf": [
            {
              "description": "ISO-8601 timestamp, e.g. 2026-10-18T14:30:00",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Synced At"
        },
        "note_count": {
          "title": "Note Count",
          "type": "integer"
        },
        "source_system": {
          "title": "Source System",
          "type": "string"
        },
        "source_workspace": {
          "title": "Source Workspace",
          "type": "string"
        }
      },
      "required": [
        "source_system",
        "source_workspace",
        "note_count"
      ],
      "title": "SyncSource",
      "type": "object"
    },
    "TopLink": {
      "additionalProperties": true,
      "description": "K§2 NoteSummary.top_links item.",
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "integer"
        },
        "entity_label": {
          "title": "Entity Label",
          "type": "string"
        },
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        }
      },
      "required": [
        "entity_type",
        "entity_id",
        "entity_label"
      ],
      "title": "TopLink",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "GET /notes response.",
  "properties": {
    "hygiene": {
      "anyOf": [
        {
          "$ref": "#/$defs/HygieneBlock"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "K§6.2: present only when include_hygiene=true"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/NoteSummary"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "sync_sources": {
      "items": {
        "$ref": "#/$defs/SyncSource"
      },
      "title": "Sync Sources",
      "type": "array"
    }
  },
  "required": [
    "items",
    "sync_sources"
  ],
  "title": "NoteList",
  "type": "object"
}
