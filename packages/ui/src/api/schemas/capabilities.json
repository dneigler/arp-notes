{
  "$defs": {
    "CapabilityLimits": {
      "additionalProperties": true,
      "properties": {
        "manifest_page_size": {
          "title": "Manifest Page Size",
          "type": "integer"
        },
        "max_attachment_bytes": {
          "title": "Max Attachment Bytes",
          "type": "integer"
        },
        "max_attachments_per_note": {
          "title": "Max Attachments Per Note",
          "type": "integer"
        },
        "max_body_chars": {
          "title": "Max Body Chars",
          "type": "integer"
        },
        "max_note_bytes": {
          "title": "Max Note Bytes",
          "type": "integer"
        },
        "upload_ticket_ttl_s": {
          "title": "Upload Ticket Ttl S",
          "type": "integer"
        }
      },
      "required": [
        "max_attachment_bytes",
        "max_note_bytes",
        "max_body_chars",
        "max_attachments_per_note",
        "manifest_page_size",
        "upload_ticket_ttl_s"
      ],
      "title": "CapabilityLimits",
      "type": "object"
    },
    "CapabilityScheme": {
      "additionalProperties": true,
      "properties": {
        "entity_types": {
          "items": {
            "type": "string"
          },
          "title": "Entity Types",
          "type": "array"
        },
        "prefix": {
          "title": "Prefix",
          "type": "string"
        }
      },
      "required": [
        "prefix",
        "entity_types"
      ],
      "title": "CapabilityScheme",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "GET /notes/capabilities: built from Policy plus schemes and the judge name (K§12.4).",
  "properties": {
    "attachments": {
      "title": "Attachments",
      "type": "boolean"
    },
    "export": {
      "title": "Export",
      "type": "boolean"
    },
    "hygiene": {
      "title": "Hygiene",
      "type": "boolean"
    },
    "judge": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Judge"
    },
    "kinds": {
      "items": {
        "type": "string"
      },
      "title": "Kinds",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/CapabilityLimits"
    },
    "llm_enrich": {
      "title": "Llm Enrich",
      "type": "boolean"
    },
    "mime_allowlist": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mime Allowlist"
    },
    "propose_on_sync": {
      "enum": [
        "off",
        "search",
        "judge"
      ],
      "title": "Propose On Sync",
      "type": "string"
    },
    "protocol": {
      "const": 1,
      "title": "Protocol",
      "type": "integer"
    },
    "schemes": {
      "items": {
        "$ref": "#/$defs/CapabilityScheme"
      },
      "title": "Schemes",
      "type": "array"
    },
    "someday": {
      "title": "Someday",
      "type": "boolean"
    },
    "source_systems": {
      "items": {
        "type": "string"
      },
      "title": "Source Systems",
      "type": "array"
    }
  },
  "required": [
    "protocol",
    "attachments",
    "mime_allowlist",
    "limits",
    "kinds",
    "source_systems",
    "export",
    "llm_enrich",
    "schemes",
    "someday",
    "hygiene",
    "propose_on_sync",
    "judge"
  ],
  "title": "Capabilities",
  "type": "object"
}
