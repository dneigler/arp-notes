{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One pickable candidate on an ambiguous ProposedLink or an unresolved mention.",
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "duplicate_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "K§2: equal values mark the same work or composer by the K§4 dedupe key",
      "title": "Duplicate Group"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "integer"
    },
    "entity_label": {
      "title": "Entity Label",
      "type": "string"
    },
    "entity_type": {
      "title": "Entity Type",
      "type": "string"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "entity_label",
    "confidence"
  ],
  "title": "ProposalCandidate",
  "type": "object"
}
