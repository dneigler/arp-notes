{
  "name": "@arpinator/notes-ui",
  "version": "0.1.0-dev.0",
  "description": "arp-notes UI: note view, editor and proposal-review components, styled only with --arpn-* CSS variables.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "dist",
    "src/styles/tokens.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "demo": "vite --config vite.demo.config.js",
    "test:e2e": "playwright test",
    "schemas:vendor": "node scripts/vendor-schemas.mjs",
    "schemas:check": "node scripts/vendor-schemas.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
